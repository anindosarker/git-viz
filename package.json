{
  "name": "git-viz",
  "displayName": "git-viz",
  "description": "git visualizer",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "publisher": "anindosarker",
  "icon": "icon.png",
  "license": "MIT",
  "keywords": [
    "git",
    "visualization",
    "graph",
    "history",
    "gui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anindosarker/git-viz.git"
  },
  "bugs": {
    "url": "https://github.com/anindosarker/git-viz/issues"
  },
  "homepage": "https://github.com/anindosarker/git-viz#readme",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-viz.showCommitGraph",
        "title": "GitViz: Show Commit Graph"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build --workspace=web && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "workspaces": [
    "web",
    "shared",
    "backend"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "@git-viz/backend": "1.0.0",
    "@git-viz/shared": "1.0.0"
  }
}
