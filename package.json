{
  "name": "git-viz",
  "displayName": "git-viz",
  "description": "git visualizer",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "publisher": "anindosarker",
  "icon": "icon.png",
  "license": "MIT",
  "keywords": [
    "git",
    "visualization",
    "graph",
    "history",
    "gui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anindosarker/git-viz.git"
  },
  "bugs": {
    "url": "https://github.com/anindosarker/git-viz/issues"
  },
  "homepage": "https://github.com/anindosarker/git-viz#readme",
  "activationEvents": [
    "onView:git-viz.repoTree",
    "onCommand:git-viz.showCommitGraph",
    "workspaceContains:**/.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "git-viz",
          "title": "Git Viz",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "git-viz": [
        {
          "id": "git-viz.repoTree",
          "name": "Repositories",
          "contextualTitle": "Git Viz"
        }
      ]
    },
    "commands": [
      {
        "command": "git-viz.showCommitGraph",
        "title": "Show Commit Graph",
        "category": "GitViz"
      },
      {
        "command": "git-viz.switchBranch",
        "title": "Switch Branch",
        "category": "GitViz"
      },
      {
        "command": "git-viz.openSettings",
        "title": "Open Settings",
        "category": "GitViz"
      },
      {
        "command": "git-viz.refresh",
        "title": "Refresh",
        "category": "GitViz",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "git-viz.refresh",
          "when": "view == git-viz.repoTree",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "git-viz.showCommitGraph",
        "key": "ctrl+shift+g ctrl+shift+v",
        "mac": "cmd+shift+g cmd+shift+v"
      },
      {
        "command": "git-viz.refresh",
        "key": "f5",
        "when": "activeWebviewPanelId == git-viz.commitGraph"
      }
    ],
    "configuration": {
      "title": "Git Viz",
      "properties": {
        "git-viz.graphStyle": {
          "type": "string",
          "enum": [
            "gitlens-like",
            "git-graph-like",
            "vscode-scm-graph-like"
          ],
          "default": "gitlens-like",
          "description": "Visual preset for the commit graph"
        },
        "git-viz.refDisplay": {
          "type": "string",
          "enum": [
            "inline",
            "left-column",
            "right-column"
          ],
          "default": "left-column",
          "description": "Where ref labels are rendered relative to the commit row"
        },
        "git-viz.rowHeight": {
          "type": "number",
          "default": 24,
          "description": "Height of each commit row in pixels"
        },
        "git-viz.pageSize": {
          "type": "number",
          "default": 500,
          "description": "Number of commits fetched per page"
        },
        "git-viz.topoOrder": {
          "type": "boolean",
          "default": true,
          "description": "Order commits topologically rather than by date"
        },
        "git-viz.dateFormat": {
          "type": "string",
          "enum": [
            "relative",
            "absolute",
            "iso"
          ],
          "default": "relative",
          "description": "How commit dates are formatted"
        },
        "git-viz.showWorkingTree": {
          "type": "boolean",
          "default": true,
          "description": "Show a row for the uncommitted working tree state"
        },
        "git-viz.columns": {
          "type": "array",
          "description": "Visible columns and their order",
          "default": [
            "graph",
            "subject",
            "refs",
            "author",
            "date",
            "hash"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm --filter web build && pnpm compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:all": "pnpm -r build",
    "start:server": "node server.cjs",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "@git-viz/backend": "workspace:*",
    "@git-viz/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.2.1"
  }
}
